# English routes. false: French only, no /en/ URLs. true: generate /en/ and show the hero switcher.
# hreflang still follows siteConfig.publishedLocales (ARM Services: fr).
ENABLE_MULTILANG=false

# ContentForge blocks. ARM Services imports nothing: keep all three false.
# "true" fetches that resource at build time. "false" keeps FAQ and reviews in the locale JSON
# and does not generate /blog. A failed fetch falls back the same way.
CONTENTFORGE_FAQ_ENABLED=false
CONTENTFORGE_REVIEWS_ENABLED=false
CONTENTFORGE_ARTICLES_ENABLED=false
CONTENTFORGE_URL=https://contentforge.1344.fr/api/v1
CONTENTFORGE_API_TOKEN=

# Contact form: ContentForge send_form (exposed to the browser — use a site token, not a global secret).
# PUBLIC_CONTACT_FORM_URL=https://contentforge.1344.fr/api/v1/send_form
# PUBLIC_CONTACT_FORM_TOKEN=your_site_bearer_token
PUBLIC_CONTACT_FORM_URL=https://contentforge.1344.fr/api/v1/send_form
PUBLIC_CONTACT_FORM_TOKEN=your_site_bearer_token

# --- SMTP (for the external POST handler only — not read by this static site) ---
# Typical OVH / Zimbra:
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@example.com
# SMTP_PASS=
# MAIL_FROM=contact@example.com
# MAIL_TO=contact@example.com
