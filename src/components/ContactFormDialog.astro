---
import { getFixedT, type Locale } from '../i18n/i18n';
import ContactFormFields from './ContactFormFields.astro';

interface Props {
	locale: Locale;
	showTrigger?: boolean;
	triggerClass?: string;
	triggerLabel?: string;
}

const {
	locale,
	showTrigger = true,
	triggerClass = 'inline-flex items-center justify-center px-8 py-4 border-2 border-orange-armenian text-orange-armenian font-semibold rounded-lg hover:bg-orange-armenian hover:text-gray-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian focus-visible:ring-offset-2',
	triggerLabel,
} = Astro.props;
const t = getFixedT(locale);
const openLabel = triggerLabel ?? t('ContactForm.openCta');

const contactApiUrl = import.meta.env.PUBLIC_CONTACT_FORM_URL ?? '';
const contactApiToken = import.meta.env.PUBLIC_CONTACT_FORM_TOKEN ?? '';
const contactEmailSubject = t('ContactForm.emailSubject');

const contactConfig = JSON.stringify({
	apiUrl: contactApiUrl,
	apiToken: contactApiToken,
	subject: contactEmailSubject,
	ui: {
		sending: t('ContactForm.sending'),
		success: t('ContactForm.success'),
		error: t('ContactForm.error'),
		errorNetwork: t('ContactForm.errorNetwork'),
		errorConfig: t('ContactForm.errorConfig'),
		errorPhotosCount: t('ContactForm.errorPhotosCount'),
		errorPhotosType: t('ContactForm.errorPhotosType'),
		errorPhotosRead: t('ContactForm.errorPhotosRead'),
		errorPhotosSize: t('ContactForm.errorPhotosSize'),
	},
}).replaceAll('<', '\\u003c');
---

{showTrigger && (
	<div class="mt-8">
		<button
			type="button"
			class={triggerClass}
			data-arm-contact-open
			aria-haspopup="dialog"
		>
			{openLabel}
		</button>
	</div>
)}

<dialog
	id="arm-contact-dialog"
	tabindex="-1"
	class="fixed inset-x-0 mx-auto h-fit max-h-full w-[90vw]! max-w-[90vw]! overflow-y-auto rounded-xl border border-gray-200 bg-white p-0 text-left shadow-lg outline-none backdrop:bg-gray-900 backdrop:opacity-40 open:flex open:flex-col"
	aria-labelledby="arm-contact-title"
	aria-describedby="arm-contact-intro"
>
	<div class="border-b border-gray-100 px-6 py-4">
		<h3 id="arm-contact-title" tabindex="-1" autofocus class="text-xl text-center font-bold text-gray-900 outline-none">
			{t('ContactForm.dialogTitle')}
		</h3>
	</div>
	<form id="arm-contact-form" class="flex flex-col gap-4 px-6 py-4">
		<ContactFormFields locale={locale} />
		<p
			id="arm-contact-status"
			class="hidden rounded-lg px-3 py-2 text-sm border"
			role="status"
		></p>
		<div class="flex flex-wrap justify-center gap-3 border-t border-gray-100 pt-4">
			<button
				type="button"
				class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian"
				data-arm-contact-close
			>
				{t('ContactForm.close')}
			</button>
			<button
				type="submit"
				id="arm-contact-submit"
				class="rounded-lg bg-orange-armenian px-4 py-2 text-sm font-semibold text-white hover:brightness-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian focus-visible:ring-offset-2"
			>
				{t('ContactForm.submit')}
			</button>
		</div>
	</form>
</dialog>

<script id="arm-contact-config" type="application/json" set:html={contactConfig}></script>
<script>
	import { initArmContactForm } from '../lib/armContactForm';

	initArmContactForm();
</script>
