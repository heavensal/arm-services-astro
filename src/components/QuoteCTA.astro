---
import handshakeImage from '../assets/images/handshake.jpg';
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
---
<section
	id="devis"
	class="relative min-h-80 md:min-h-96 py-16 md:py-24 bg-cover bg-center bg-no-repeat"
	style={`background-image: url(${handshakeImage.src});`}
	aria-labelledby="quote-cta-heading"
>
	<div class="absolute inset-0 bg-blue-armenian/80" aria-hidden="true"></div>

	<div class="relative z-10 container mx-auto px-4 max-w-3xl text-center">
		<h2 id="quote-cta-heading" class="text-2xl md:text-3xl font-bold text-white mb-4">
			{t('QuoteCTA.title')}
		</h2>
		<p class="text-white text-lg mb-8">
			{t('QuoteCTA.lead')}
		</p>
		<button
			type="button"
			class="cursor-pointer inline-flex items-center justify-center px-8 py-4 bg-orange-armenian text-white font-semibold rounded-lg hover:brightness-95 transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-armenian"
			data-arm-contact-open
			aria-haspopup="dialog"
		>
			{t('QuoteCTA.cta')}
		</button>
	</div>
</section>
