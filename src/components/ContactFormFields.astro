---
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const fieldClass =
	'w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-orange-armenian focus:outline-none focus:ring-2 focus:ring-orange-armenian';
---

<div>
	<label for="arm-contact-last-name" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldLastName')}
	</label>
	<input id="arm-contact-last-name" name="lastName" type="text" autocomplete="family-name" required class={fieldClass} />
</div>
<div>
	<label for="arm-contact-first-name" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldFirstName')}
	</label>
	<input id="arm-contact-first-name" name="firstName" type="text" autocomplete="given-name" required class={fieldClass} />
</div>
<div>
	<label for="arm-contact-email" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldEmail')}
	</label>
	<input id="arm-contact-email" name="email" type="email" autocomplete="email" required class={fieldClass} />
</div>
<div>
	<label for="arm-contact-phone" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldPhone')}
	</label>
	<input id="arm-contact-phone" name="phone" type="tel" autocomplete="tel" required class={fieldClass} />
</div>
<div>
	<label for="arm-contact-company" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldCompany')}
	</label>
	<input id="arm-contact-company" name="company" type="text" autocomplete="organization" class={fieldClass} />
</div>
<div>
	<label for="arm-contact-message" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldMessage')}
	</label>
	<textarea
		id="arm-contact-message"
		name="message"
		rows="5"
		placeholder={t('ContactForm.messagePlaceholder')}
		class={`${fieldClass} placeholder:text-gray-400`}
	></textarea>
</div>
<div role="group" aria-labelledby="arm-contact-photos-label">
	<span id="arm-contact-photos-label" class="mb-1 block text-sm font-medium text-gray-900">
		{t('ContactForm.fieldPhotos')}
	</span>
	<div class="flex flex-wrap items-center gap-3">
		<button
			type="button"
			class="rounded-lg bg-gray-100 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian"
			data-arm-contact-pick
			aria-describedby="arm-contact-photos-hint"
		>
			{t('ContactForm.chooseFile')}
		</button>
		<span id="arm-contact-photos-empty" class="text-sm text-gray-600">{t('ContactForm.noFileChosen')}</span>
	</div>
	<input
		id="arm-contact-photos"
		type="file"
		accept="image/jpeg,image/png,image/webp"
		multiple
		tabindex="-1"
		aria-hidden="true"
		class="sr-only"
	/>
	<ul
		id="arm-contact-previews"
		class="mt-3 grid grid-cols-3 gap-3"
		data-remove-label={t('ContactForm.removePhoto')}
		data-preview-label={t('ContactForm.photoPreview', { index: '__INDEX__' })}
	>
	</ul>
	<p id="arm-contact-photos-hint" class="mt-1 text-sm text-gray-600">{t('ContactForm.photosHint')}</p>
</div>
