---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { formatCmsDate, type CmsArticleSummary } from '../../lib/contentforge-blog';
import { homePathForLocale, localePathPrefix, pageHref } from '../../lib/paths';

interface Props {
	locale: Locale;
	posts: CmsArticleSummary[];
}

const { locale, posts } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale));
const prefix = localePathPrefix(locale);
---

<main class="min-h-screen bg-gray-50">
	<div class="container mx-auto max-w-3xl px-4 py-12 md:py-16">
		<header class="mb-10">
			<a
				href={homeUrl}
				class="mb-4 inline-block text-sm font-medium text-red-armenian hover:text-blue-armenian focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian"
			>
				{t('Blog.back')}
			</a>
			<h1 class="text-3xl font-bold text-gray-900 md:text-4xl">{t('Blog.h1')}</h1>
			<p class="mt-3 leading-relaxed text-gray-600">{t('Blog.intro')}</p>
		</header>
		{
			posts.length === 0 ? (
				<p class="text-gray-600">{t('Blog.empty')}</p>
			) : (
				<ul class="space-y-6">
					{posts.map((post) => {
						const date = formatCmsDate(post.publishedAt, locale);
						return (
							<li class="rounded-lg border border-gray-200 bg-white p-6">
								<h2 class="text-xl font-semibold text-gray-900">
									<a
										href={pageHref(`${prefix}blog/${post.slug}`)}
										class="hover:text-red-armenian focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian"
									>
										{post.title}
									</a>
								</h2>
								{date && (
									<p class="mt-2 text-sm text-gray-500">
										<time datetime={post.publishedAt ?? undefined}>{date}</time>
									</p>
								)}
								{post.description && <p class="mt-3 text-gray-600">{post.description}</p>}
							</li>
						);
					})}
				</ul>
			)
		}
	</div>
</main>
