---
import { fetchReviews } from '../lib/contentforge-blocks';
import { getFixedT, type Locale } from '../i18n/i18n';
import { siteConfig } from '../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const { yoojo } = siteConfig;
const yoojoStats = {
	count: yoojo.reviewCountMin,
	rating: yoojo.rating,
};

const fallbackReviews = [1, 2, 3, 4].map((n) => ({
	name: t(`Reviews.r${n}n`),
	text: t(`Reviews.r${n}t`),
	stars: 5,
}));
const fromApi = await fetchReviews(locale);
const reviews = fromApi
	? fromApi.map((review) => ({
			name: review.author,
			text: review.content,
			stars: review.rating,
		}))
	: fallbackReviews;
---
<section class="py-16 md:py-24 bg-gray-50 overflow-hidden" aria-labelledby="reviews-heading">
	<div class="container mx-auto px-4 max-w-6xl">
		<h2 id="reviews-heading" class="text-2xl md:text-3xl font-bold text-gray-900 text-center mb-12">
			{t('Reviews.title')}
		</h2>

		<div class="mb-10 flex justify-center px-4">
			<div class="relative flex w-full max-w-xl flex-col items-center gap-5 overflow-hidden rounded-2xl border border-blue-100 bg-white px-8 py-7 text-center shadow-md sm:flex-row sm:text-left">
				{/* Bande bleue décorative en haut */}
				<div class="absolute inset-x-0 top-0 h-1 bg-[#0078fa]" aria-hidden="true"></div>

				{/* Séparateur vertical sur desktop */}
				<div class="hidden sm:block w-px self-stretch bg-gray-100" aria-hidden="true"></div>

				{/* Texte + logo inline */}
				<div class="flex-1">
					<p class="font-bold text-gray-900 text-base flex flex-wrap items-center justify-center gap-x-2 sm:justify-start">
						<span>{t('Reviews.yoojoBadge')}</span>
						<svg fill="none" viewBox="0 0 499 212" xmlns="http://www.w3.org/2000/svg" class="inline-block h-5 w-auto" role="img" aria-label="Yoojo">
							<g fill="#0078fa">
								<path d="m361.95 33.1717c8.8 0 15.933-7.1274 15.933-15.9195 0-8.79201-7.133-15.91938-15.933-15.91938s-15.934 7.12737-15.934 15.91938c0 8.7921 7.134 15.9195 15.934 15.9195z"/>
								<path d="m321.539 209.678c4.116 1.371 9.694 2.039 16.696 2.039 12.009 0 21.147-3.492 27.265-10.597 6.098-7.083 9.08-17.626 9.08-31.489v-119.9312h-25.118v119.2652c0 6.894-1.254 11.794-3.617 14.849l-.005.007-.005.007c-2.327 3.145-6.128 4.793-11.601 4.793-4.226 0-8.301-.582-12.228-1.745l-.998-.295v22.92z"/>
								<path clip-rule="evenodd" d="m161.451 162.288c31.766 0 57.517-25.728 57.517-57.465 0-31.7375-25.751-57.4655-57.517-57.4655s-57.517 25.728-57.517 57.4655c0 31.737 25.751 57.465 57.517 57.465zm0-25.098c17.892 0 32.396-14.492 32.396-32.367 0-17.8761-14.504-32.3672-32.396-32.3672s-32.396 14.4911-32.396 32.3672c0 17.875 14.504 32.367 32.396 32.367z" fill-rule="evenodd"/>
								<path clip-rule="evenodd" d="m340.221 104.823c0 31.737-25.752 57.465-57.517 57.465-31.766 0-57.518-25.728-57.518-57.465 0-31.7375 25.752-57.4655 57.518-57.4655 31.765 0 57.517 25.728 57.517 57.4655zm-25.121 0c0 17.875-14.505 32.367-32.396 32.367-17.892 0-32.397-14.492-32.397-32.367 0-17.8761 14.505-32.3672 32.397-32.3672 17.891 0 32.396 14.4911 32.396 32.3672z" fill-rule="evenodd"/>
								<path d="m83.3691 49.6997h27.0119l-60.1526 159.5743h-26.3261l18.2888-50.079-41.41384-109.4953h27.01284l27.6741 79.7933z"/>
								<path clip-rule="evenodd" d="m499 104.835c0 15.443-6.097 29.463-16.017 39.788-.512.534-1.035 1.057-1.568 1.571-10.33 9.958-24.381 16.089-39.865 16.106h-.14c-31.733-.039-57.444-25.752-57.444-57.465 0-31.737 25.751-57.465 57.517-57.465s57.517 25.728 57.517 57.465zm-16.813 0c0 5.892-1.254 11.491-3.51 16.545l-14.979-6.663c1.386-3.018 2.158-6.368 2.158-9.894 0-13.2956-10.962-24.0735-24.484-24.0735s-24.484 10.7779-24.484 24.0735c0 7.745 3.721 14.636 9.5 19.04l-10.19 12.844c-9.394-7.449-15.42-18.957-15.42-31.872 0-22.4599 18.224-40.6675 40.705-40.6675 22.48 0 40.704 18.2076 40.704 40.6675zm-33.144-.012c0 3.766-3.18 7.275-7.671 7.275s-7.671-3.509-7.671-7.275 3.18-7.276 7.671-7.276 7.671 3.51 7.671 7.276z" fill-rule="evenodd"/>
							</g>
						</svg>
						<span class="text-[#0078fa]">!</span>
					</p>
					<div class="mt-1 flex items-center justify-center gap-1 sm:justify-start" aria-hidden="true">
						{Array.from({ length: yoojo.rating }).map(() => (
							<span class="text-amber-400 text-xl">★</span>
						))}
					</div>
					<p class="mt-1 text-sm text-gray-500">
						{t('Reviews.yoojoStats', yoojoStats)}
					</p>
				</div>

				{/* CTA — seul élément avec le lien externe */}
				<a
					href={yoojo.profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg bg-[#0078fa] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 shrink-0"
				>
					{t('Reviews.yoojoCta')}
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			</div>
		</div>

		<div class="relative -mx-4 md:mx-0">
			<div
				class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 px-4 md:px-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			>
				{reviews.map((review) => (
					<article
						class="flex flex-col shrink-0 w-11/12 sm:w-96 max-w-sm snap-center bg-white rounded-xl shadow-md p-6 border border-gray-100"
					>
						<div class="flex items-center gap-1 mb-3" role="img" aria-label={t('Reviews.starsAria', { count: review.stars })}>
							{Array.from({ length: 5 }).map((_, index) => (
								<span class={index < review.stars ? 'text-amber-400' : 'text-gray-300'} aria-hidden="true">★</span>
							))}
						</div>
						<p class="text-gray-700 mb-4 flex-1">"{review.text}"</p>
						<p class="text-gray-500 font-medium mt-auto">{review.name}</p>
					</article>
				))}
			</div>
		</div>
		<p class="mt-3 text-right text-xs text-gray-600 px-4 md:px-0">
			{fromApi ? t('Reviews.sourceApi') : t('Reviews.source')}
		</p>
	</div>
</section>

