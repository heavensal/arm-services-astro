---
import { fetchFaqs } from '../lib/contentforge-blocks';
import { getFixedT, type Locale } from '../i18n/i18n';
import { siteConfig } from '../site.config';

interface Props {
	locale: Locale;
}

interface FaqItem {
	answer: string;
	question: string;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const telHref = `tel:${siteConfig.contact.phone.replace(/\s/g, '')}`;

const faqKeys = ['item1', 'item2', 'item3', 'item4'] as const;

const getFallbackItems = (): FaqItem[] =>
	faqKeys
		.map((itemKey) => {
			const questionKey = `Faq.${itemKey}Question`;
			const answerKey = `Faq.${itemKey}Answer`;
			const question = t(questionKey);
			const answer = t(answerKey);
			if (question === questionKey || answer === answerKey) return null;
			return { answer, question };
		})
		.filter((item): item is FaqItem => item !== null);

const fromApi = await fetchFaqs(locale);
const items = fromApi ?? getFallbackItems();
---

<section
	id="faq"
	class="border-t border-gray-200 bg-gray-50 px-4 py-20 md:py-24"
	aria-labelledby="heading-faq"
>
	<div class="container mx-auto max-w-4xl">
		<header class="mx-auto mb-12 max-w-2xl text-center md:mb-14">
			<h2
				id="heading-faq"
				class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl"
			>
				{t('Faq.title')}
			</h2>
			<p class="leading-relaxed text-gray-600">{t('Faq.intro')}</p>
		</header>
		<div class="space-y-4">
			{
				items.map((item: FaqItem) => (
					<details class="group rounded-lg border border-gray-200 bg-white">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left marker:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian">
							<span class="text-lg font-medium text-gray-900">
								{item.question}
							</span>
							<span class="text-2xl text-gray-400 transition-transform group-open:rotate-45">
								+
							</span>
						</summary>
						<p class="px-6 pb-6 text-gray-600">{item.answer}</p>
					</details>
				))
			}
		</div>
		<div class="mt-10 text-center">
			<p class="text-sm text-gray-500">{t('Faq.moreQuestions')}</p>
			<a
				href={telHref}
				class="mt-4 inline-flex items-center gap-2 justify-center rounded-lg border border-gray-300 px-6 py-3 text-sm font-medium text-gray-700 transition-colors hover:border-gray-400 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-armenian"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				{t('Faq.contactCta')}
			</a>
		</div>
	</div>
</section>
