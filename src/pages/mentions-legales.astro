---
import Layout from '../layouts/Layout.astro';
import LegalNoticeArticle from '../components/legal/LegalNoticeArticle.astro';
import { getFixedT, type Locale } from '../i18n/i18n';
import { absolutePageUrl, buildLegalAlternateLanguages, buildLegalNoticeJsonLd } from '../lib/seo';
import { legalSlugs } from '../lib/paths';

const locale: Locale = 'fr';
const t = getFixedT(locale);
const frUrl = absolutePageUrl(Astro.site, legalSlugs.fr.legalNotice);
const enUrl = absolutePageUrl(Astro.site, `en/${legalSlugs.en.legalNotice}`);
const homeUrl = absolutePageUrl(Astro.site, '');
---

<Layout
	lang="fr"
	ogLocale="fr_FR"
	title={t('LegalNotice.metaTitle')}
	description={t('LegalNotice.metaDescription')}
	alternateLanguages={buildLegalAlternateLanguages(frUrl, enUrl)}
	jsonLd={homeUrl ? buildLegalNoticeJsonLd(homeUrl) : undefined}
	skipToContentLabel={t('Layout.skipToContent')}
>
	<LegalNoticeArticle locale={locale} />
</Layout>
