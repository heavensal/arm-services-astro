---
import BlogArticle from '../../components/blog/BlogArticle.astro';
import BlogIndex from '../../components/blog/BlogIndex.astro';
import { getFixedT, type Locale } from '../../i18n/i18n';
import { blogStaticPaths } from '../../lib/contentforge-blog';
import Layout from '../../layouts/Layout.astro';
import { absolutePageUrl, buildLegalAlternateLanguages } from '../../lib/seo';

export async function getStaticPaths() {
	return blogStaticPaths('fr');
}

const locale: Locale = 'fr';
const t = getFixedT(locale);
const { article, posts } = Astro.props;
const frPath = article ? `blog/${article.slug}` : 'blog';
const enPath = article ? `en/blog/${article.slug}` : 'en/blog';
const title = article ? t('Blog.articleMetaTitle', { title: article.title }) : t('Blog.metaTitle');
const description = article?.description || t('Blog.metaDescription');
---

<Layout
	lang="fr"
	ogLocale="fr_FR"
	ogLocaleAlternate="en_US"
	title={title}
	description={description}
	alternateLanguages={buildLegalAlternateLanguages(
		absolutePageUrl(Astro.site, frPath),
		absolutePageUrl(Astro.site, enPath),
	)}
	skipToContentLabel={t('Layout.skipToContent')}
	ogImageAlt={t('Layout.ogImageAlt')}
>
	{article ? <BlogArticle locale={locale} article={article} /> : <BlogIndex locale={locale} posts={posts} />}
</Layout>
